<%- include('partials/shell-header', { pageTitle: t('admin.dashboard'), currentSection: 'dashboard' }) %>

      <div class="admin-topbar">
        <h2 class="mt-0"><%= t('admin.dashboard') %></h2>
      </div>

      <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-value"><%= stats.totalBookings %></div>
          <div class="stat-label"><%= t('admin.totalBookings') %></div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.pending %></div>
          <div class="stat-label"><%= t('admin.pendingBookings') %></div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.confirmed %></div>
          <div class="stat-label"><%= t('admin.confirmedBookings') %></div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.totalListings %></div>
          <div class="stat-label"><%= t('admin.totalListings') %></div>
        </div>
      </div>

      <div class="section-header-row">
        <h3 class="mt-0"><%= t('admin.bookings') %></h3>
        <a href="/admin/bookings" class="btn btn-secondary btn-sm"><%= t('admin.bookings') %> &rarr;</a>
      </div>

      <div class="table-card">
        <% if (recentBookings.length === 0) { %>
          <div class="empty-state"><%= t('admin.noBookings') %></div>
        <% } else { %>
        <table>
          <thead>
            <tr>
              <th><%= t('admin.customer') %></th>
              <th><%= t('admin.phone') %></th>
              <th><%= t('admin.for') %></th>
              <th><%= t('admin.date') %></th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% recentBookings.forEach(function(b) { %>
              <tr>
                <td><%= b.customerName %></td>
                <td><%= b.customerPhone %></td>
                <td><%= lang === 'am' ? b.listingTitleAm : b.listingTitleEn %></td>
                <td><%= new Date(b.createdAt).toLocaleDateString() %></td>
                <td><span class="badge badge-<%= b.status %>"><%= b.status %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% } %>
      </div>

<%- include('partials/shell-footer') %>
